# Copiar este archivo a terraform.tfvars y completar con los valores reales.
# terraform.tfvars NUNCA se sube al repo (ver .gitignore).

# --- VM de VirtualBox ya creada ---
vm_ssh_host     = "192.168.56.10"
vm_ssh_port     = 22
vm_ssh_user     = "ubuntu"
vm_ssh_password = "CHANGE_ME"

# --- Registro del runner en GitHub ---
github_owner = "matiaspasa-cloudhesive"
github_repo  = "AppPIN_devops"
github_pat   = "CHANGE_ME" # PAT con permiso Administration: Read and write sobre el repo

# El label con el runner_name (ultimo elemento) permite targetear este runner
# especifico en un matrix de ci.yml cuando hay mas de un runner registrado.
runner_name     = "virtualbox-runner-01"
runner_labels   = "self-hosted,linux,x64,virtualbox,virtualbox-runner-01"
runner_work_dir = "_work"
runner_version  = "2.321.0"

# --- .env de la app (docker compose). Se escribe en la VM, en ---
# --- /home/<vm_ssh_user>/<app_deploy_dir>/.env, para que el job deploy ---
# --- del CI (docker compose up) lo encuentre sin pasarle los secrets. ---
app_deploy_dir       = "pin-app-deploy"
mysql_root_password  = "CHANGE_ME"
mysql_database       = "gestion_usuarios"
mysql_user           = "appuser"
mysql_password       = "CHANGE_ME"
jwt_secret           = "CHANGE_ME"
